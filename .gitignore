ehthumbs.db
Thumbs.db
Desktop.ini

# Logs and databases
*.log
*.sqlite
*.db

# Local development settings
.env
.env.local
.env.*
!.env.example

# Sensitive information files
*password*
*secret*
*credential*
*token*
*key*
*auth*
*config.json
*settings.json

# Temporary files
*.tmp
*.temp
*.bak
*~

