# Output directory containing generated files
output/
vendor_distribution.html
*-Devices.csv
vendor_summary.txt
*shadowvendor_siem.*
*shadowvendor_runtime.log
# Legacy netvendor files (should not exist, but ignore if they do)
*netvendor_siem.*
*netvendor_runtime.log

# Network data files (case insensitive)
*[Aa][Rr][Pp]*.txt      # ARP data files
*[Mm][Aa][Cc]*.txt      # MAC address table files
*[Vv][Ll][Aa][Nn]*.txt  # VLAN data files
*[Cc][Dd][Pp]*.txt      # CDP neighbor data
*[Ll][Ll][Dd][Pp]*.txt  # LLDP neighbor data
*[Cc][Oo][Nn][Ff]*.txt  # Config files
*-Devices.txt           # Device files
*.pcap                  # Packet captures
*.cap                   # Packet captures
*.dump                  # Network dumps
*.log                   # Log files

# Data and cache files
*.csv                   # All CSV files
failed_lookups.json    # Failed lookups cache
processed_files.json   # Processed files cache
oui_database.json      # OUI database
oui_cache.json         # OUI cache file (user-generated)
data/                  # Data directory

# Test data files (but allow tests/data/*.txt for quick start examples)
*test*.txt
!tests/data/test-*.txt
*sample*.txt
example*.txt
mock*.txt

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environments
venv/
env/
.env/
.venv/
ENV/

# IDE settings
.vscode/
.idea/
*.sublime-*
*.swp
*.swo
.project
.pydevproject
.settings/

